{
  "expo": {
    "name": "ذِكْر",
    "slug": "dhikr-counter",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/launcher-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B132B",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.dhikr.counter",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B132B",
        "foregroundImage": "./assets/launcher-foreground.png",
        "backgroundImage": "./assets/launcher-background.png",
        "monochromeImage": "./assets/launcher-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B132B",
          "image": "./assets/splash-emblem.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#0B132B",
            "image": "./assets/splash-emblem.png",
            "imageWidth": 240,
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#0B132B",
              "image": "./assets/splash-emblem.png"
            }
          },
          "ios": {
            "backgroundColor": "#0B132B",
            "image": "./assets/splash-emblem.png",
            "imageWidth": 240,
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#0B132B",
              "image": "./assets/splash-emblem.png"
            }
          },
          "dark": {
            "backgroundColor": "#0B132B",
            "image": "./assets/splash-emblem.png"
          }
        }
      ]
    ]
  }
}
